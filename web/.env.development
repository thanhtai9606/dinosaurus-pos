# Relative path → Vite proxy to backend :8080 (see vite.config.ts)
VITE_API_BASE=/api/v1
# Optional: override WebSocket endpoint (default in dev: ws://<hostname>:8080/api/v1/ws)
# VITE_WS_URL=ws://localhost:8080/api/v1/ws
# Firebase web push (optional — must match Firebase Console)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
